#!/bin/bash
# ============================================================================
# pre-push hook — blocks push to main on partner servers
# ============================================================================
# Install: cp deploy/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# Or: setup-partner-complete.sh installs this automatically
# ============================================================================

REMOTE="$1"
URL="$2"

while read local_ref local_sha remote_ref remote_sha; do
  if echo "$remote_ref" | grep -qE '(refs/heads/main|refs/heads/master)'; then
    # Allow on dev-server (hostname contains "dev" or is the known dev hostname)
    HOSTNAME=$(hostname)
    if [ -f /etc/cui-partner ]; then
      echo "ERROR: Push to main/master is BLOCKED on partner servers."
      echo "       Use 'develop' branch. Production deploys via deploy-production."
      exit 1
    fi
  fi
done

exit 0
