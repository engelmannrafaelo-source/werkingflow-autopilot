{
  "appId": "com.werkingflow.cui-partner",
  "productName": "WerkING CUI",
  "directories": {
    "output": "dist-partner"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "!node_modules/**/*",
    "node_modules/electron/**/*"
  ],
  "extraMetadata": {
    "main": "electron/main-partner.cjs"
  },
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": [
      {
        "target": "zip",
        "arch": ["arm64", "x64"]
      }
    ],
    "icon": null,
    "darkModeSupport": true,
    "identity": null
  },
  "win": {
    "target": [
      { "target": "zip", "arch": ["x64"] }
    ],
    "icon": null,
    "signAndEditExecutable": false
  },
  "linux": {
    "category": "Development",
    "target": [
      { "target": "AppImage", "arch": ["x64"] }
    ],
    "icon": null
  },
  "asarUnpack": []
}
