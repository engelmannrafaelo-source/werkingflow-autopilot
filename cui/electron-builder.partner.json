{
  "appId": "com.werkingflow.cui-partner",
  "productName": "WerkING CUI",
  "directories": {
    "output": "dist-partner"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "!node_modules/**/*",
    "node_modules/electron/**/*"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      }
    ],
    "icon": null,
    "darkModeSupport": true
  },
  "dmg": {
    "title": "WerkING CUI",
    "contents": [
      { "x": 130, "y": 220 },
      { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
    ]
  },
  "extraResources": [
    {
      "from": "electron/",
      "to": "electron/",
      "filter": ["*.cjs"]
    }
  ]
}
